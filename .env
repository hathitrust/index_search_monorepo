# Environment variables for running locally (not in a container)
# This file is *not* mounted into running containers, so containers
# need to define their own environment variables via docker compose or
# kubernetes.

RABBITMQ_INDEXER_RW_HOST=localhost
RABBITMQ_INDEXER_RW_PORT=5672
RABBITMQ_INDEXER_RW_USERNAME=guest
RABBITMQ_INDEXER_RW_PASSWORD=guest

# once tracktable is removed, the need should be read-only
MYSQL_HT_RO_HOST=localhost
MYSQL_HT_RO_USERNAME=mdp-admin
MYSQL_HT_RO_PASSWORD=mdp-admin
MYSQL_HT_RO_DATABASE=ht

# URL including basic auth to solr core for querying full text
FULL_TEXT_SOLR_RO_URL=http://admin:solrRocks@localhost:8983/solr/core-x

# URL including basic auth if needed to solr core for querying catalog
CATALOG_SOLR_RO_URL=http://localhost:9033/solr/catalog

# Used in many places -- to clean up
SOLR_USER=admin
SOLR_PASSWORD=solrRocks

# Location for material to index -- shouldn't need for tests
# SDR_DIR=../sdr1/obj
