# Environment variables for running locally (not in a container)
# This file is *not* mounted into running containers, so containers
# need to define their own environment variables via docker compose or
# kubernetes.

# for development
LOG_LEVEL=DEBUG

# RabbitMQ credentials. *Not* overrideable by service
RABBITMQ_HT_INDEXER_HOST=localhost
RABBITMQ_HT_INDEXER_USERNAME=guest
RABBITMQ_HT_INDEXER_PASSWORD=guest

# Override specific service rabbitmq queue parameters as follows:
# See also for example app/ht_indexer/src/document_retriever_service/retriever_config.yml
#
# RABBITMQ_RETRIEVER_ prefix: for document retriever service queue
# RABBITMQ_RETRIEVER_HEARTBEAT=300
#
# RABBITMQ_GENERATOR_SRC_ / RABBITMQ_GENERATOR_TGT_ prefixes: for document generator source and target queues:
# RABBITMQ_GENERATOR_SRC_SHUTDOWN_ON_EMPTY_QUEUE=TRUE
# RABBITMQ_GENERATOR_TGT_MAX_MESSAGE_SIZE=1234567
#
# RABBITMQ_INDEXER_ prefix: for document indexer service queue
# RABBITMQ_INDEXER_BATCH_SIZE=20

# once tracktable is removed, the need should be read-only
MYSQL_HT_RO_HOST=localhost
MYSQL_HT_RO_USERNAME=mdp-admin
MYSQL_HT_RO_PASSWORD=mdp-admin
MYSQL_HT_RO_DATABASE=ht

# URL including basic auth to solr core for querying full text
FULL_TEXT_SOLR_RO_URL=http://admin:solrRocks@localhost:8983/solr/core-x

# URL including basic auth if needed to solr core for querying catalog
CATALOG_SOLR_RO_URL=http://localhost:9033/solr/catalog
# Optional basic auth for the catalog Solr (leave unset while the catalog does not require auth)
# SOLR_CATALOG_RO_USERNAME=
# SOLR_CATALOG_RO_PASSWORD=

# Used in many places -- to clean up
SOLR_USER=admin
SOLR_PASSWORD=solrRocks

# Location for material to index -- shouldn't need for tests
# SDR_DIR=../sdr1/obj
