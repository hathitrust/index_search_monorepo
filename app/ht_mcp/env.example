# Base URL of the catalog API that the MCP server calls to look up catalog data.
# The default matches the babel local-dev setup; set it for other environments.
CATALOG_URL=http://apache:8080

# Port the MCP server listens on.
# AI clients (e.g. Claude Desktop) connect to this port.
MCP_PORT=8000
MCP_HOST=0.0.0.0

LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=10
